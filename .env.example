# ===== Obrigatório =====
NODE_ENV=production
APP_URL=https://app.seudominio.com.br
PORT=3100
# Primeiro administrador (criado só se ainda não existir nenhum)
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Seu Nome

# ===== Opcional =====
DATA_DIR=./data
SESSION_DAYS=60
ADMIN_SESSION_HOURS=12
SCHEDULER_MINUTES=10
# Atrás do Nginx: confia no X-Forwarded-For para IP real e rate limit
TRUST_PROXY=true
